# Secrets — defense in depth. The Concept2 token is never meant to live in this
# repo (it's entered via HA's config flow and stored in HA's own encrypted
# storage), but these patterns are ignored anyway in case of local experiments.
secrets.yaml
*.token
.env
.env.*
